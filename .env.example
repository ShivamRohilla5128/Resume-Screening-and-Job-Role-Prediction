# Copy to .env (never commit .env)
MONGO_URI=mongodb://localhost:27017
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net     # MongoDB Atlas
# MONGO_URI=mongomock                                                 # in-memory demo DB (data lost on restart)
MONGO_DB=resume_screening
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_HOURS=8
TOKEN_HOURS_REMEMBER=336
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
MAX_FILES_PER_REQUEST=25
RESUME_RETENTION_DAYS=30
ANALYSIS_RETENTION_DAYS=180
